# --- Django ---
# Cle secrete de Django : en generer une avec
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-moi-par-une-vraie-cle

# Copier ce fichier en ".env" puis remplir les valeurs (ne jamais publier .env).

# --- Gmail ---
# Adresse Gmail qui ENVOIE l'alerte
EMAIL_HOST_USER=
# Mot de passe d'APPLICATION Google (16 lettres), pas le mot de passe normal
EMAIL_HOST_PASSWORD=
# Adresse qui RECOIT l'alerte (peut etre la meme)
ALERT_EMAIL_TO=

# --- Telegram ---
# Token donne par @BotFather (ex : 123456789:AA...)
TELEGRAM_TOKEN=
# Identifiant de la conversation (trouve avec getUpdates)
TELEGRAM_CHAT_ID=

# --- Regles d'alerte ---
# Alerte si temperature STRICTEMENT superieure a ce seuil (en degres C)
ALERT_THRESHOLD=25
# Delai minimum entre deux alertes, en secondes (0 = une alerte par mesure, comme le TP)
ALERT_COOLDOWN_SECONDS=60
